# API Keys
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Required: OpenAI API key (for GPT-4o, TTS, and Whisper)
OPENAI_API_KEY=sk-your-openai-key-here

# Required: NewsData.io API key (free tier: 200 credits/day)
# Get one at: https://newsdata.io/register
NEWSDATA_API_KEY=your-newsdata-key-here

# Required for Buffer scheduling. Keep the real key only in .env.
BUFFER_API_KEY=your-buffer-api-key-here
BUFFER_PROFILE_NAME=NeuralDropBits
# Optional: comma-separated Buffer channel IDs. Use this to lock scheduling
# to specific NeuralDropBits channels when several connected channels match.
BUFFER_CHANNEL_IDS=

# Required for scheduling videos through Buffer. Must be public HTTPS, not localhost.
BUFFER_PUBLIC_MEDIA_BASE_URL=https://your-public-api.example.com

# Used when BUFFER_PUBLIC_MEDIA_BASE_URL is not set. Files up to 25 MB go to
# Discord; larger files go to GitHub storage.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
GITHUB_STORAGE_REPO=panavm12-jpg/storage
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_PREFIX=news
